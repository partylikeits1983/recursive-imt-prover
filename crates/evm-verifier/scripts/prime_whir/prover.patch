+++ b/src/bin/imt_prime_fixture.rs
@@ -0,0 +1,55 @@
+use alloy_sol_types::SolValue;
+use spartan_whir_export::{
+    abi_export::{proof_to_abi, statement_to_abi},
+    fixed_config_codegen::generate_octic_fixed_config_source_named,
+    quartic_fixture::build_standalone_fixture,
+    OcticBinExtension, SecurityConfig, SoundnessAssumption, WhirParams,
+};
+fn main() -> anyhow::Result<()> {
+    let dir = std::path::PathBuf::from(
+        std::env::args()
+            .nth(1)
+            .ok_or_else(|| anyhow::anyhow!("missing output directory"))?,
+    );
+    let t = std::time::Instant::now();
+    let f = build_standalone_fixture::<OcticBinExtension>(
+        SecurityConfig {
+            security_level_bits: 135,
+            merkle_security_bits: 128,
+            soundness_assumption: SoundnessAssumption::JohnsonBound,
+        },
+        WhirParams {
+            pow_bits: 20,
+            folding_factor: 4,
+            starting_log_inv_rate: 6,
+            rs_domain_initial_reduction_factor: 3,
+            folding_schedule: None,
+            round_log_inv_rates: Vec::new(),
+        },
+        22,
+    )?;
+    let statement = statement_to_abi(&f.statement_points, &f.statement_evaluations);
+    let proof = proof_to_abi(&f.proof)?;
+    std::fs::write(
+        dir.join("call-args.bin"),
+        (proof.initialCommitment, statement, proof).abi_encode_params(),
+    )?;
+    std::fs::write(
+        dir.join("config.sol"),
+        generate_octic_fixed_config_source_named(
+            &f,
+            "OcticWhirFixedConfig_k22_jb100_lir6_ff4_rsv1",
+        ),
+    )?;
+    for r in &f.config.round_parameters {
+        println!(
+            "q={} ood={} foldpow={}",
+            r.num_queries, r.ood_samples, r.folding_pow_bits
+        );
+    }
+    println!(
+        "verified in Rust with checkpoint equality, total elapsed {:?}",
+        t.elapsed()
+    );
+    Ok(())
+}
