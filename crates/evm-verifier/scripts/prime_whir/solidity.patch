@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+import { WhirVerifierUtils8 as U } from "./WhirVerifierUtils8.sol";
+import { MerkleVerifier as M } from "../../merkle/MerkleVerifier.sol";
+
+library FullWidthRows {
+    function open(
+        uint256[] calldata indices,
+        uint256[] calldata values,
+        uint256 depth,
+        bytes32[] calldata siblings,
+        uint256[] calldata points,
+        bool base
+    ) external pure returns (bytes32 root, uint256[] memory evals) {
+        require(values.length == indices.length * 16 && points.length == 4);
+        bytes32[] memory hashes = new bytes32[](indices.length);
+        evals = new uint256[](indices.length);
+        for (uint256 i; i < indices.length; ++i) {
+            if (base) {
+                (hashes[i], evals[i]) = U._hashAndEvaluateBaseRowDim4PackedPoints(
+                    values, 16 * i, points[0], points[1], points[2], points[3]
+                );
+            } else {
+                (hashes[i], evals[i]) = U._hashAndEvaluateExtensionRowDim4PackedPoints(
+                    values, 16 * i, points[0], points[1], points[2], points[3]
+                );
+            }
+        }
+        root = M.computeRootFromLeafHashes(indices, hashes, depth, siblings, 32);
+    }
+}
