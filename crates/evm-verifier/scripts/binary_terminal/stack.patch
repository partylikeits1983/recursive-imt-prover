+pub(crate) fn trace_basis_point(group: &str, index: u64, point: &[E]) {
+    let words: Vec<u128> = point.iter().map(|v| u128::from(v.c0) | u128::from(v.c1) << 64).collect();
+    eprintln!("PROFILE basis_point {group} {index} {words:?}");
+}
